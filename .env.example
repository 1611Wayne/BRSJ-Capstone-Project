# Copy this file to .env.local and fill in the values from the Supabase dashboard.
# .env.local is git-ignored. Never commit real keys, and never paste them into chat or the group chat.

# Project Settings -> Data API (or the "Connect" button): the Project URL, like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys: the PUBLISHABLE key (sb_publishable_...), or on older projects the "anon public" key.
# Safe for the browser; the access rules (RLS) decide what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API Keys: the SECRET key (sb_secret_...), or on older projects the "service_role" key.
# SERVER ONLY. It bypasses every access rule. Never put NEXT_PUBLIC_ in front of this name.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in mode. supabase = real accounts in the database (needs the values above).
# Leave it empty to use the prototype sample accounts (maria@... etc.) with browser-only data.
NEXT_PUBLIC_AUTH_MODE=

# The "not a robot" check (Cloudflare Turnstile) on Login, Register and Send Code. Public, so NEXT_PUBLIC_ is fine.
# Its secret key goes in the Supabase dashboard (Authentication -> Attack Protection), never here.
# For testing, Cloudflare's always-pass test key: 1x00000000000000000000AA (pair it with the test secret
# 1x0000000000000000000000000000000AA in Supabase). Replace both with real keys before real use.
# Leave empty to turn the check off in the app (then it must also be off in Supabase, or every sign-in fails).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
